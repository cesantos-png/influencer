{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub-influencers",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "hub-influencers", "database_id": "459bb71e-7733-4f32-a5f4-247862a378b9" }
  ],
  "kv_namespaces": [
    { "binding": "BLOBS", "id": "47ac9b8641a74ebc85f0c9cff50944cb" }
  ],
  // ADMINS (e-mails dos administradores) é definida no painel: Settings > Variables and Secrets.
  "keep_vars": true,
  "observability": { "enabled": true }
}
